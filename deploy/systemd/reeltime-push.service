# Sends push notifications (Notifications in the profile menu) every few
# seconds. Runs as the same dynamic user as the web service so it reads
# the same database and VAPID key. Install steps: deploy/README.md.
[Unit]
Description=ReelTime push notifications
Documentation=file:///opt/reeltime/deploy/README.md
After=reeltime.service network-online.target
Wants=network-online.target
# The web service migrates the database first.
Requires=reeltime.service

[Service]
Type=exec
User=reeltime
DynamicUser=yes
StateDirectory=reeltime
StateDirectoryMode=0700
WorkingDirectory=/opt/reeltime
EnvironmentFile=/etc/reeltime/reeltime.env
Environment=DJANGO_SETTINGS_MODULE=reeltime.settings.prod
Environment=REELTIME_DATA_DIR=%S/reeltime
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
LoadCredential=secret_key:/etc/reeltime/secret_key
LoadCredential=oidc_client_secret:/etc/reeltime/oidc_client_secret
Environment=REELTIME_SECRET_KEY_FILE=%d/secret_key
Environment=OIDC_CLIENT_SECRET_FILE=%d/oidc_client_secret
ExecStart=/opt/reeltime/.venv/bin/reeltime push
Restart=on-failure
RestartSec=5

# Sandboxing. It reaches push services over the internet, so unlike the
# nightly service it has a network.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
MemoryMax=256M
TasksMax=32

[Install]
WantedBy=multi-user.target
